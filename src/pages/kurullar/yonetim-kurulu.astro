---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { board } from '../../data/site';

const asil = board.filter((m) => m.type === 'asil');
const yedek = board.filter((m) => m.type === 'yedek');
const initials = (n: string) =>
  n.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toLocaleUpperCase('tr-TR');
---

<Base
  title="Yönetim Kurulu"
  description="Kapsayıcı ve Erişilebilir Yaşam Derneği yönetim kurulu asil ve yedek üyeleri."
>
  <PageHero
    eyebrow="Derneğimiz"
    title="Yönetim Kurulu"
    lede="Derneğimizin genel kurul tarafından seçilen yönetim kurulu asil ve yedek üyeleri."
    crumbs={[{ label: 'Derneğimiz', href: '/kurumsal/hakkimizda' }, { label: 'Yönetim Kurulu' }]}
  />

  <section class="section">
    <div class="shell">
      <h2 class="group-title">Asil Üyeler</h2>
      <ul class="board-grid">
        {asil.map((m, i) => (
          <li class="member reveal" style={`--d:${i * 70}ms`}>
            <span class="avatar" aria-hidden="true">{initials(m.name)}</span>
            <span class="who">
              <strong>{m.name}</strong>
              <span class="role">{m.role}</span>
            </span>
          </li>
        ))}
      </ul>

      <h2 class="group-title">Yedek Üyeler</h2>
      <ul class="board-grid compact">
        {yedek.map((m, i) => (
          <li class="member reveal" style={`--d:${i * 60}ms`}>
            <span class="avatar sm" aria-hidden="true">{initials(m.name)}</span>
            <span class="who">
              <strong>{m.name}</strong>
              <span class="role">{m.role}</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="note">
        Yönetim kurulu, Dernek Tüzüğü’nün ilgili maddeleri uyarınca genel kurul
        tarafından seçilir. Ayrıntılar için
        <a href="/kurumsal/dernek-tuzugu">Dernek Tüzüğü</a> sayfasını inceleyebilirsiniz.
      </p>
    </div>
  </section>
</Base>

<style>
  .group-title {
    font-family: var(--font-body);
    font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--highlight-text);
    margin: 0 0 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--line-strong);
  }
  .group-title + .board-grid { margin-bottom: 3rem; }

  .board-grid {
    list-style: none; margin: 0 0 1rem; padding: 0;
    display: grid; gap: var(--gap);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 265px), 1fr));
  }
  .member {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-raised);
    border: 2.5px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: var(--raise);
    transition: transform var(--tr), box-shadow var(--tr);
  }
  .member:hover { transform: translate(-3px, -3px); box-shadow: var(--raise-lg); }
  .avatar {
    display: grid; place-items: center; flex: 0 0 auto;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--indigo-700); color: #fff;
    border: 2.5px solid var(--line-strong);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 20, 'WONK' 1;
    font-size: 1.35rem; font-weight: 700; letter-spacing: 0.01em;
  }
  .avatar.sm { width: 46px; height: 46px; font-size: 1.1rem; background: var(--amber-400); color: var(--indigo-950); }
  .who { display: flex; flex-direction: column; min-width: 0; }
  .who strong { font-size: var(--step-0); line-height: 1.3; }
  .role { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--highlight-text); }
  .compact .who strong { font-size: var(--step--1); }

  .note {
    margin-top: 2rem; padding: 1.1rem 1.3rem;
    background: var(--bg-sunken); border-left: 5px solid var(--highlight);
    border-radius: var(--radius-sm);
    font-size: var(--step--1); color: var(--text-muted);
  }
</style>
