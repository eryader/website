---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa Bulunamadı" description="Aradığınız sayfa bulunamadı." noindex={true}>
  <section class="nf braille-field">
    <div class="shell-narrow center">
      <p class="code" aria-hidden="true">404</p>
      <h1>Aradığınız sayfayı bulamadık</h1>
      <p class="lede">
        Sayfa taşınmış, adı değişmiş veya adres yanlış yazılmış olabilir.
        Aşağıdaki bağlantılardan devam edebilirsiniz.
      </p>
      <div class="stack-actions center-actions">
        <a class="btn btn-primary" href="/">Anasayfaya dön</a>
        <a class="btn" href="/site-haritasi">Site haritası</a>
        <a class="btn btn-ghost" href="/iletisim">İletişim</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 3rem + 6vw, 8rem); }
  .code {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    font-size: clamp(5rem, 3rem + 14vw, 12rem);
    font-weight: 900; line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--highlight);
    margin: 0 0 1rem;
  }
  .lede { color: var(--text-muted); font-size: var(--step-1); max-width: 48ch; margin-inline: auto; margin-bottom: 2rem; }
  .center-actions { justify-content: center; }
</style>
