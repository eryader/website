---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  href?: string;
  linkLabel?: string;
  /** Başlık ve bağlantıyı yan yana yerleştirir. */
  row?: boolean;
}
const { eyebrow, title, lede, href, linkLabel = 'Tümünü Gör', row = true } = Astro.props;
---

<div class:list={['section-head', row && href && 'section-head-row']}>
  <div>
    {eyebrow && (
      <p class="eyebrow">
        <span class="braille-mark" aria-hidden="true"><i></i><i class="off"></i><i class="off"></i><i></i><i></i><i class="off"></i></span>
        {eyebrow}
      </p>
    )}
    <h2>{title}</h2>
    {lede && <p class="lede">{lede}</p>}
  </div>
  {href && (
    <a class="btn btn-sm btn-ghost" href={href}>
      {linkLabel}
      <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  )}
</div>
