---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Arama motorlarından gizlenecek yardımcı sayfalar için. */
  noindex?: boolean;
}

const { title, description = site.shortDesc, image = '/images/eryader-logo.png', noindex = false } = Astro.props;

const pageTitle = title === site.fullName ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.fullName,
  alternateName: site.name,
  url: site.url,
  logo: new URL('/images/eryader-logo.png', Astro.site ?? site.url).href,
  description: site.shortDesc,
  email: 'info@eryader.org',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Erzurum Mh. Dumlupınar Cad. Geçim Sokak No:21/5',
    postalCode: '06590',
    addressLocality: 'Çankaya',
    addressRegion: 'Ankara',
    addressCountry: 'TR',
  },
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/images/eryader-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/eryader-logo.png" />
    <meta name="theme-color" content="#3b2c7d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Tema/kontrast tercihleri ilk boyamadan önce uygulanır — ekran titremesi olmaz. */}
    <script is:inline>
      (function () {
        try {
          var d = document.documentElement;
          var p = JSON.parse(localStorage.getItem('eryader-a11y') || '{}');
          if (p.theme) d.dataset.theme = p.theme;
          if (p.contrast) d.dataset.contrast = p.contrast;
          if (p.fontsize) d.dataset.fontsize = p.fontsize;
          if (p.motion) d.dataset.motion = p.motion;
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
